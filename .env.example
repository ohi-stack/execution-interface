# Runtime
NODE_ENV=development
PORT=3000

# Service metadata
APP_NAME=onegodian-api
APP_VERSION=1.0.0

# CORS (comma-separated list, no spaces required)
# Example: https://onegodian.org,https://api.onegodian.org
CORS_ORIGINS=

# Optional trust proxy setting for reverse proxies (true|false)
TRUST_PROXY=false
