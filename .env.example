# ================================
# ONEGODIAN API — ENV SYSTEM
# ================================

# Core
NODE_ENV=development
PORT=3000
APP_NAME=onegodian-api
APP_URL=http://localhost:3000

# Public URLs
PUBLIC_APP_URL=https://app.onegodian.com
API_BASE_URL=https://api.onegodian.org

# Security
API_KEY=change-this
JWT_SECRET=change-this-super-long-secret
CORS_ORIGIN=http://localhost:3000,https://app.onegodian.com

# Database (future-ready)
DATABASE_URL=
ENABLE_DATABASE=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ================================
# ONEGODIAN TIME SYSTEM (CRITICAL)
# ================================

OT_STANDARD=OTS-V5
OT_EPOCH=2025-03-18
OT_WEEK_START=SKENRA_SUNDAY
OT_DEFAULT_TIMEZONE=America/New_York
OT_STORE_UTC=true

# ================================
# FEATURE FLAGS
# ================================

ENABLE_CALENDAR=true
ENABLE_SCHEDULER=true
ENABLE_ODIN=true
ENABLE_CAPITAL_API=false

# ================================
# LOGGING
# ================================

LOG_LEVEL=info
