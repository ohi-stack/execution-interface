NEXT_PUBLIC_APP_VERSION=1.1.0
NEXTAUTH_URL=https://app.onegodian.com
NEXTAUTH_SECRET=replace-with-generated-secret
DATABASE_URL=postgresql://ino:change-me@postgres:5432/ino_platform
REDIS_URL=redis://redis:6379
WORDPRESS_URL=https://onegodian.org
WORDPRESS_APP_USERNAME=service-account
WORDPRESS_APP_PASSWORD=replace-with-application-password
WEBHOOK_SECRET=replace-with-strong-shared-secret
WEBHOOK_REPLAY_WINDOW_MS=300000
JWT_SECRET=replace-with-generated-secret
ENCRYPTION_KEY=replace-with-32-byte-key

# OneGodian ecosystem canonical URLs
NEXT_PUBLIC_ONEGODIAN_ORG_URL=https://onegodian.org
NEXT_PUBLIC_ONEGODIAN_COM_URL=https://onegodian.com
NEXT_PUBLIC_UNIVERSITY_URL=https://u.onegodian.com
NEXT_PUBLIC_GALAXY_URL=https://galaxy.onegodian.com
NEXT_PUBLIC_CAPITAL_URL=https://capital.onegodian.com
NEXT_PUBLIC_OMOS_URL=https://omos.onegodian.com
NEXT_PUBLIC_OBP1_URL=https://obp1.onegodian.org
NEXT_PUBLIC_TIME_URL=https://time.onegodian.org
NEXT_PUBLIC_QUANTUMOHI_URL=https://quantumohi.com
NEXT_PUBLIC_QRV_URL=https://qrv.network

# OneGodian Members bridge — server-side secret only
ONEGODIAN_MEMBERS_REST_BASE_URL=https://onegodian.org/wp-json/onegodian-members/v1
ONEGODIAN_MEMBERS_BRIDGE_KEY=

# OMOS runtime bridge — server-side secret only
OMOS_API_BASE_URL=https://omos.onegodian.com
OMOS_APP_BRIDGE_KEY=

# ODC Sprint 4 accounts and read-only wallets
AUTH_SECRET=replace-with-generated-secret
AUTH_URL=https://odc.onegodian.com
APP_BASE_URL=https://odc.onegodian.com
ETHEREUM_CHAIN_ID=1
ETHEREUM_RPC_PRIMARY=
ETHEREUM_RPC_SECONDARY=
ODC_CONTRACT_ADDRESS=0x9eee1e3615efe0374a7588d2760db5ffb2d5ce98
ODC_TOKEN_SYMBOL=ODC
ODC_TOKEN_DECIMALS=18
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
AUDIT_LOG_SECRET=replace-with-generated-secret

# ODC public explorer (server-only; never prefix secrets with NEXT_PUBLIC_)
ETHEREUM_RPC_URL=
EXPLORER_API_URL=
EXPLORER_API_KEY=
DEPLOYMENT_TIMESTAMP=
