NODE_ENV=production
NEXT_PUBLIC_ACC_VERSION=1.0.0
NEXT_PUBLIC_ACC_DOMAIN=acc.onegodian.com
NEXT_PUBLIC_ACC_URL=https://acc.onegodian.com
NEXT_PUBLIC_ACC_REPOSITORY=https://github.com/ohi-stack/acc

# ACC is interface-only. These point to external authorities; do not replace them with ACC-local authority.
OSCC_BASE_URL=https://oscc.onegodian.com
OCP_BASE_URL=https://ocp.onegodian.com
OEG_BASE_URL=https://oeg.onegodian.com
IDENTITY_BASE_URL=https://identity.onegodian.com
REGISTRY_BASE_URL=https://registry.onegodian.com
AUDIT_BASE_URL=https://audit.onegodian.com

# OMOS production platform authentication
OMOS_SESSION_SECRET=
OMOS_SESSION_TTL_SECONDS=28800
# Comma-separated email:scrypt$salt$hash:role records. Generate hashes out-of-band; never store plaintext passwords.
OMOS_AUTH_USERS=
OMOS_MODEL_PROVIDER_STATUS_URL=
OMOS_WORDPRESS_PLUGIN_TARGETS=onegodian-members,omos-site-bridge
