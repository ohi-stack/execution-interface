{
  "name": "onegodian-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Core API for api.onegodian.org",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development node --watch src/index.ts",
    "check": "node --check server.js && node --check src/app.js && node --check src/controllers/healthController.js && node --check src/controllers/verificationController.js && node --check src/controllers/api/v1Controller.js && node --check src/routes/index.js && node --check src/routes/api/v1Routes.js && node --check src/services/recordStore.js",
    "test": "node --test test/*.js",
    "validate:enforcement": "node scripts/validate-enforcement.mjs",
    "validate:prod": "node scripts/validate-prod.mjs",
    "smoke:prod": "node scripts/smoke-check-qrv.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^7.2.0",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "stripe": "^17.7.0",
    "zod": "^3.25.76",
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "prisma": "^6.8.2"
  }
}
