{
  "name": "onegodian-app-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:web": "npm install --prefix apps/web",
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "prisma:generate": "npm run prisma:generate --prefix apps/web",
    "prisma:migrate": "npm run prisma:migrate --prefix apps/web",
    "prisma:seed": "npm run prisma:seed --prefix apps/web"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
