{
  "name": "onegodian-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready TypeScript Express API baseline for Onegodian",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "helmet": "7.1.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.3",
    "tsx": "4.19.2",
    "typescript": "5.8.3"
  }
}
