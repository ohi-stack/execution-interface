{
  "name": "onegodian-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Core API for api.onegodian.org",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "start:with-build": "npm run build && npm start",
    "validate:enforcement": "node scripts/validate-enforcement.mjs",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run validate:enforcement && npm run lint && npm run typecheck && npm run test && npm run test:root && npm run build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test:root": "node --test test/*.test.js",
    "validate:prod-env": "node scripts/validate-production-env.mjs",
    "smoke:prod": "node scripts/production-smoke-check.mjs",
    "detect:config-conflicts": "node scripts/detect-config-conflicts.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "onegodian-agent",
    "onegodian-time",
    "onegodian-algorithm",
    "onegodian-protocol",
    "onegodian-experience",
    "onegodian-community",
    "onegodian-orientation",
    "onegodian-core",
    "onegodian-identity",
    "onegodian-docs"
  ],
  "packageManager": "npm@10.9.4"
}
