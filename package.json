{
  "name": "onegodian-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Core API for api.onegodian.org",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "start:with-build": "npm run build && npm start",
    "validate:enforcement": "node scripts/validate-enforcement.mjs",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run validate:enforcement && npm run lint && npm run typecheck && npm run test && npm run test:root && npm run build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test:root": "node --test test/*.test.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "onegodian-agent",
    "onegodian-time",
    "onegodian-algorithm",
    "onegodian-protocol",
    "onegodian-experience",
    "onegodian-community",
    "onegodian-orientation",
    "onegodian-core",
    "onegodian-identity",
    "onegodian-docs"
  ]
}
