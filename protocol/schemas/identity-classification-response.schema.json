{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onegodian.io/schemas/identity-classification-response.schema.json",
  "title": "Identity Classification Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "result"],
  "properties": {
    "ok": { "const": true },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "level",
        "framework",
        "scoring",
        "canonical_time_standard"
      ],
      "properties": {
        "score": { "type": "number" },
        "level": {
          "type": "string",
          "enum": ["Seeker", "Believer", "Onegodian", "Elder"]
        },
        "framework": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "min", "description"],
            "properties": {
              "name": { "type": "string" },
              "min": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "scoring": {
          "type": "object",
          "required": ["studyHours", "serviceActs", "mentorshipCount"],
          "properties": {
            "studyHours": {
              "type": "object",
              "required": ["weight", "minimum"],
              "properties": {
                "weight": { "type": "number" },
                "minimum": { "type": "number" }
              }
            },
            "serviceActs": {
              "type": "object",
              "required": ["weight", "minimum"],
              "properties": {
                "weight": { "type": "number" },
                "minimum": { "type": "number" }
              }
            },
            "mentorshipCount": {
              "type": "object",
              "required": ["weight", "minimum"],
              "properties": {
                "weight": { "type": "number" },
                "minimum": { "type": "number" }
              }
            }
          }
        },
        "canonical_time_standard": { "const": "gregorian_utc" }
      }
    }
  }
}
