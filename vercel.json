{
  "version": 2,
  "framework": "nextjs",
  "github": {
    "silent": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "x-onegodian-surface", "value": "acc" }
      ]
    }
  ]
}
