<?xml version="1.0"?>
<ruleset name="One Companion">
  <description>Security-focused checks for the production foundation.</description>
  <file>one-companion-platform.php</file><file>includes</file><exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="WordPress.Security.EscapeOutput"/><rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"/><rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="Generic.PHP.NoSilencedErrors"/>
</ruleset>
